  "narrationCaptions": [
    {"start":0.35,"end":2.3,"text":"Crecer era obligatorio."},
    {"start":3.18,"end":5.9,"text":"Dejar de juntarse… no."},
    {"start":7.35,"end":11.25,"text":"Pero esta noche,\nlos pendientes cobraron vida."},
    {"start":12.05,"end":15.05,"text":"Las excusas se rompen a martillazos."},
    {"start":15.54,"end":19.0,"text":"La paciencia… también se acaba."},
    {"start":19.60,"end":22.3,"text":"Y la amistad pega fuerte."},
    {"start":23.05,"end":25.95,"text":"Pero siempre hay quien te levante."},
    {"start":26.76,"end":28.6,"text":"¿Permiso para tener vida?"},
    {"start":29.04,"end":30.25,"text":"Denegado."},
    {"start":30.98,"end":32.45,"text":"Cinco amigos."},
    {"start":32.76,"end":34.0,"text":"Una montaña."},
    {"start":34.45,"end":36.15,"text":"Cero excusas."},
    {"start":36.68,"end":39.85,"text":"La junta… no se cancela."},
    {"start":40.34,"end":43.4,"text":"La Leyenda del Magdaleno."}
  ]
